DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/invitations
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
PORT=3001

# Email is required for password recovery; RSVP notifications also use it.
# Recovery stays unavailable until SMTP_HOST and a sender are configured.
# CLIENT_URL must be the public frontend origin (HTTPS in production).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=

# Reverse-proxy hops to trust for IP rate limiting. Defaults to 1 on Vercel,
# otherwise 0. Set only to match the actual trusted proxy topology.
# TRUST_PROXY_HOPS=0
